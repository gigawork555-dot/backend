# ── FDD §13: "MQTT over TLS 1.2" ─────────────────────────────
# ค่า default ต้องเป็น False เพื่อไม่กระทบ environment ปัจจุบัน
# (dev ใช้ plain MQTT port 1883/1884) — ตั้งเป็น True เมื่อ broker
# มี TLS cert พร้อมใช้งานแล้วเท่านั้น (การสร้าง/ตั้งค่า cert ฝั่ง
# broker เป็นงาน infra แยกต่างหาก ไม่ใช่ส่วนของโค้ดนี้)
MQTT_TLS_ENABLED=False
# path ของ CA cert บนเครื่อง/คอนเทนเนอร์ backend เมื่อเปิดใช้ TLS
# ปล่อยว่างได้ถ้าต้องการใช้ system default CA store
MQTT_CA_CERT_PATH=